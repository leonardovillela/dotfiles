{{- $work := promptBoolOnce . "work" "Is this a work machine" -}}

[data]
  work = {{ $work }}

[diff]
  pager = "delta"
  exclude = ["scripts"]

# [merge]
#    command = "nvim"
#    args = ["-d", "{{ "{{ .Destination }}" }}", "{{ "{{ .Source }}" }}", "{{ "{{ .Target }}" }}"]
#

[merge]
  command = "bash"
  args = [
    "-c",
    "cp {{ "{{ .Target }} {{ .Target }}" }}.base && code --new-window --wait --merge {{ "{{ .Destination }} {{ .Target }} {{ .Target }}" }}.base {{ "{{ .Source }}" }}",
  ]
