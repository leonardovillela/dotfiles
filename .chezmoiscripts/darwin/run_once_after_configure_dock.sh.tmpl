#!/usr/bin/env bash

{{ if eq .chezmoi.os "darwin" -}}
# Configure macOS Dock with preferred applications
# This script runs only once during initial bootstrap

echo "Configuring Dock..."

# Remove all apps from the Dock
dockutil --remove all --no-restart

# Add apps in the desired order (Finder is always first and can't be moved)
apps=(
  "/Applications/Visual Studio Code.app"
  "/Applications/Ghostty.app"
  "/Applications/Spotify.app"
  "/Applications/GitHub Copilot.app"
  "/Applications/Slack.app"
  "/Applications/Todoist.app"
  "/Applications/Bitwarden.app"
  "/Applications/Google Chrome.app"
)
for app in "${apps[@]}"; do
  if [ -d "$app" ]; then
    dockutil --add "$app" --no-restart
  else
    echo "Skipping $(basename "$app" .app): not installed"
  fi
done

# Restart Dock to apply changes
killall Dock

echo "Dock configuration complete!"

{{ end -}}
